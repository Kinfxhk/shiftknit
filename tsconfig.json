{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "test/**/*.ts",
    "vitest.config.ts",
    "e2e/**/*.ts",
    "playwright.config.ts",
    "packages/web/vite.config.ts"
  ]
}
